{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mo.local/schemas/solver-opt/optimize-job-payload-v0.json",
  "title": "OptimizeJobPayload",
  "description": "Q4-9 Jobs jobType=optimize payload (draft; align docs/drafts/Q4-NSGA-II跨服务边界.md §4.3). MVP evaluatorProfile=analytic.",
  "type": "object",
  "required": ["variables", "objectives", "nsga", "evaluatorProfile"],
  "additionalProperties": true,
  "properties": {
    "projectId": { "type": "string", "format": "uuid" },
    "memsRef": { "type": "string" },
    "baseSolveRequest": {
      "type": "object",
      "description": "Baseline SolveRequest for analytic adapter (RF+PMSM MVP)."
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "bounds"],
        "properties": {
          "id": { "type": "string" },
          "path": {
            "type": "string",
            "description": "Dot path into baseSolveRequest, e.g. geometry.magnet_thickness_m"
          },
          "type": { "type": "string", "enum": ["continuous", "integer", "discrete"] },
          "bounds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          },
          "discreteSet": {
            "type": "array",
            "items": { "type": "number" }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "sense", "metricId"],
        "properties": {
          "id": { "type": "string" },
          "sense": { "type": "string", "enum": ["minimize", "maximize"] },
          "metricId": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["inequality", "equality"] },
          "expr": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "nsga": {
      "type": "object",
      "required": ["popSize", "generations", "seed"],
      "properties": {
        "popSize": { "type": "integer", "minimum": 2, "maximum": 64 },
        "generations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "seed": { "type": "integer" }
      }
    },
    "evaluatorProfile": {
      "type": "string",
      "enum": ["analytic", "analytic+drive", "analytic+fem"]
    }
  }
}
