! ms_gap_force_3d — closed pot-core; PM magnetization; Maxwell Fz on lid
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 3D
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Steady state
  Steady State Max Iterations = 1
  Output Intervals = 1
  Post File = "ms_gap.vtu"
End

Constants
  Permittivity of Vacuum = 8.854187817e-12
  Permeability of Vacuum = 1.2566370614e-6
End

Body 1
  Target Bodies(1) = 1
  Name = "iron_stator"
  Equation = 1
  Material = 1
End

Body 2
  Target Bodies(1) = 2
  Name = "pm"
  Equation = 1
  Material = 2
  Body Force = 1
End

Body 3
  Target Bodies(1) = 3
  Name = "airgap"
  Equation = 1
  Material = 3
  airgap_mask = Logical True
End

Body 4
  Target Bodies(1) = 4
  Name = "iron_target"
  Equation = 1
  Material = 1
End

Body 5
  Target Bodies(1) = 5
  Name = "air"
  Equation = 1
  Material = 3
End

Equation 1
  Name = "Magnetostatic"
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = "MGDynamics"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Variable = "A"
  Fix Input Current Density = Logical True
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStabL
  BiCGStabL Polynomial Degree = 4
  Linear System Max Iterations = 3000
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = None
  Linear System Residual Output = 50
  Linear System Abort Not Converged = False
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Consistent Norm = Logical True
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "A"
  Calculate Magnetic Flux Density = Logical True
  Calculate Magnetic Field Strength = Logical True
  Calculate Nodal Forces = Logical True
  Calculate Maxwell Stress = Logical True
  Calculate Elemental Fields = Logical True
  Linear System Solver = Iterative
  Linear System Iterative Method = CG
  Linear System Max Iterations = 3000
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = None
  Linear System Residual Output = 0
  Steady State Convergence Tolerance = 0
  Nonlinear System Consistent Norm = Logical True
End

Solver 3
  Exec Solver = After All
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = "scalars.dat"
  Save Component Results = Logical True
  Show Norm Index = 1
  Variable 1 = String "Magnetic Flux Density 3"
  Operator 1 = String "body mean"
  Mask Name 1 = String "airgap_mask"
  Variable 2 = String "Magnetic Flux Density 3"
  Operator 2 = String "body rms"
  Mask Name 2 = String "airgap_mask"
End

Material 1
  Name = "IronSoft"
  Relative Permeability = 10000.0
  Relative Permittivity = 1.0
  Electric Conductivity = 0.0
End

Material 2
  Name = "PM"
  Relative Permeability = 1.05
  Relative Permittivity = 1.0
  Electric Conductivity = 0.0
End

Material 3
  Name = "Air"
  Relative Permeability = 1.0
  Relative Permittivity = 1.0
  Electric Conductivity = 0.0
End

Body Force 1
  Name = "PMmag"
  Magnetization 1 = Real 0.0
  Magnetization 2 = Real 0.0
  Magnetization 3 = Real 795774.715459
End

Component 1
  Name = String "iron_target"
  Master Bodies(1) = Integer 4
  Calculate Magnetic Force = Logical True
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Name = "exterior"
  A {e} = Real 0.0
End
