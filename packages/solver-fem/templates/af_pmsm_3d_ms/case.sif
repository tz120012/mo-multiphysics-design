! =============================================================================
! af_pmsm_3d_ms — MAGNETOSTATIC TRUE PATH (Q5-2)
! equationMode = magnetostatic
! pending_calibration = true
! magnetostaticPathReady = true
!
! Elmer: WhitneyAVSolver + MagnetoDynamicsCalcFields (nodal / Maxwell force)
! Postprocess: Component magnetic force 3 → axialForceN (Fz)
! Magnetostatic WhitneyAV true path (not heat-proxy). Do NOT claim FEM ≤3% / MVP.
! =============================================================================
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh"
End

Simulation
  Max Output Level = 4
  Coordinate System = Cartesian 3D
  Simulation Type = Steady state
  Steady State Max Iterations = 1
  Output Intervals = 1
  Post File = "af_ms.vtu"
End

Constants
  Permittivity of Vacuum = 8.854187817e-12
End

Body 1
  Target Bodies(1) = 1
  Name = "coil_pm"
  Equation = 1
  Material = 1
  Body Force = 1
End

Body 2
  Target Bodies(1) = 2
  Name = "airgap"
  Equation = 1
  Material = 2
End

Body 3
  Target Bodies(1) = 3
  Name = "iron"
  Equation = 1
  Material = 3
End

Equation 1
  Name = "Magnetostatic"
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = "MGDynamics"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Variable = "AV"
  Fix Input Current Density = Logical True
  Edge Basis = Logical True
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStabL
  BiCGStabL Polynomial Degree = 4
  Linear System Max Iterations = 2000
  Linear System Convergence Tolerance = 1.0e-6
  Linear System Preconditioning = None
  Linear System Residual Output = 50
  Linear System Abort Not Converged = False
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Consistent Norm = Logical True
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Magnetic Flux Density = Logical True
  Calculate Magnetic Field Strength = Logical True
  Calculate Nodal Forces = Logical True
  Calculate Maxwell Stress = Logical True
  Linear System Solver = Iterative
  Linear System Iterative Method = CG
  Linear System Max Iterations = 2000
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = None
  Linear System Residual Output = 0
  Steady State Convergence Tolerance = 0
  Nonlinear System Consistent Norm = Logical True
End

Solver 3
  Exec Solver = After All
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = "scalars.dat"
  Save Component Results = Logical True
  Show Norm Index = 1
End

Material 1
  Name = "CoilLike"
  Relative Permeability = 1.0
  Relative Permittivity = 1.0
  Electric Conductivity = 1.0e6
End

Material 2
  Name = "Air"
  Relative Permeability = 1.0
  Relative Permittivity = 1.0
End

Material 3
  Name = "Iron"
  Relative Permeability = 1000.0
  Relative Permittivity = 1.0
End

! Uniform Jx in coil body → B; iron Component Maxwell/nodal force → Fz smoke
Body Force 1
  Name = "Jx"
  Current Density 1 = Real 1.0e6
  Current Density 2 = Real 0.0
  Current Density 3 = Real 0.0
End

Component 1
  Name = String "iron_target"
  Master Bodies(1) = Integer 3
  Calculate Magnetic Force = Logical True
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Name = "exterior"
  AV {e} = Real 0.0
  AV = Real 0.0
End
