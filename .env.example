# Gate0 local deps — Mo-运维 ↔ Mo-后端 contract
# Host ports deliberately avoid 5432/6379 to reduce clash with other projects.
POSTGRES_USER=mo
POSTGRES_PASSWORD=mo
POSTGRES_DB=mo
POSTGRES_PORT=5433
REDIS_PORT=6380

# In-compose (service DNS). From containers use postgres/redis hostnames.
DATABASE_URL=postgresql+psycopg://mo:mo@postgres:5432/mo
REDIS_URL=redis://redis:6379/0

# From host (API run on host, deps in compose):
# DATABASE_URL=postgresql+psycopg://mo:mo@127.0.0.1:5433/mo
# REDIS_URL=redis://127.0.0.1:6380/0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
