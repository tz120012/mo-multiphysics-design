# Mo local deps — Mo-运维 ↔ Mo-后端
POSTGRES_USER=mo
POSTGRES_PASSWORD=mo
POSTGRES_DB=mo
# Host publish ports (avoid clash with other projects)
POSTGRES_PORT=5433
REDIS_PORT=6380

# In-compose (service DNS). From host API process use:
#   DATABASE_URL=postgresql+psycopg://mo:mo@127.0.0.1:5433/mo
#   REDIS_URL=redis://127.0.0.1:6380/0
DATABASE_URL=postgresql+psycopg://mo:mo@postgres:5432/mo
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Future API
# API_HOST_PORT=8000
