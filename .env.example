# Gate0 local deps — Mo-运维 ↔ Mo-后端 contract
POSTGRES_USER=mo
POSTGRES_PASSWORD=mo
POSTGRES_DB=mo
POSTGRES_PORT=5432
REDIS_PORT=6379

# In-compose (service DNS). Host-side tools may use localhost instead of postgres/redis.
DATABASE_URL=postgresql+psycopg://mo:mo@postgres:5432/mo
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Future API
# API_HOST_PORT=8000
