# Mo one-click stack — Mo-运维 ↔ Mo-后端
POSTGRES_USER=mo
POSTGRES_PASSWORD=mo
POSTGRES_DB=mo
# Host publish ports (avoid clash with other projects)
POSTGRES_PORT=5433
REDIS_PORT=6380
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# In-compose (service DNS). Host-side tools use localhost:5433 / :6380.
DATABASE_URL=postgresql+psycopg://mo:mo@postgres:5432/mo
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Q2-6 / Q3-3 — set 1 when `make up-worker` / `make up-fem` (compose also injects)
CELERY_ENABLED=0
MO_FEM_WORKDIR=/var/mo/fem

# Q3 FEM (container / worker only; do not install Elmer on host)
SOLVER_FEM_PATH=/opt/mo/packages/solver-fem
MO_FEM_WORKDIR=/var/mo/fem
# 1=stub job（默认）；真 Elmer 端到端：命令行 MO_FEM_DRY_RUN=0 后 recreate worker-fem（见 docs/deploy-local.md）
MO_FEM_DRY_RUN=1
